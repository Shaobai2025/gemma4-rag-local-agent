# Ollama service
OLLAMA_BASE_URL=http://127.0.0.1:11434

# LLM models
QA_MODEL=gemma4:e4b
NOTICE_MODEL=gemma4:e4b
PAPER_MODEL=gemma4:27b
VISION_MODEL=llava

# Embedding model
EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Server
HOST=127.0.0.1
PORT=8000

# Excel Agent cleanup
EXCEL_SESSION_MAX_AGE_HOURS=24
EXCEL_CLEANUP_INTERVAL_MINUTES=60
